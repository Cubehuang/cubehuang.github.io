ne","hoverRectColor":"","hoverRectRadius":5,"lineColor":"#333333","lineDasharray":"none","lineWidth":4,"lineMarkerDir":"end","lineFlow":false,"lineFlowForward":true,"lineFlowDuration":1},"children":[]},{"data":{"text":"<p><span>目的</span></p>","uid":"74e5fa1a-7267-4a70-b193-3e5d519f4097","richText":true,"expand":true,"isActive":false,"fontFamily":"微软雅黑, Microsoft YaHei","fontSize":14,"fontWeight":"normal","fontStyle":"normal","textDecoration":"none","color":"rgb(30, 53, 86)","textAlign":"left","tagPlacement":"right","imgPlacement":"top","paddingX":15,"paddingY":5,"shape":"rectangle","borderWidth":1,"borderRadius":5,"gradientStyle":false,"startColor":"#549688","endColor":"#fff","startDir":[0,0],"endDir":[1,0],"fillColor":"transparent","borderColor":"rgb(30, 53, 86)","borderDasharray":"none","hoverRectColor":"","hoverRectRadius":5,"lineColor":"#333333","lineDasharray":"none","lineWidth":4,"lineMarkerDir":"end","lineFlow":false,"lineFlowForward":true,"lineFlowDuration":1},"children":[{"data":{"text":"<p>检测应用进程中的Application的oncreate 函数是否耗时--应用进程启动过程中不能耗时过久</p>","uid":"1231b008-1abe-451c-b422-efe089913471","richText":true,"expand":true,"isActive":false},"children":[]}]}]},{"data":{"text":"<p><span>ContentProvider</span></p>","uid":"965d0724-f984-4fab-87a5-c6f28f75ddae","richText":true,"expand":true,"isActive":false,"fontFamily":"微软雅黑, Microsoft YaHei","fontSize":14,"fontWeight":"normal","fontStyle":"normal","textDecoration":"none","color":"rgb(34, 34, 34)","textAlign":"left","tagPlacement":"right","imgPlacement":"top","paddingX":15,"paddingY":5,"shape":"rectangle","borderWidth":1,"borderRadius":5,"gradientStyle":false,"startColor":"#549688","endColor":"#fff","startDir":[0,0],"endDir":[1,0],"fillColor":"transparent","borderColor":"#4D4D4D","borderDasharray":"none","hoverRectColor":"","hoverRectRadius":5,"lineColor":"rgb(34, 34, 34)","lineDasharray":"none","lineWidth":4,"lineMarkerDir":"end","lineFlow":false,"lineFlowForward":true,"lineFlowDuration":1},"children":[{"data":{"text":"<p>调用方设置timeout-ContentProvider not responding</p>","uid":"01548f0c-16fb-49e4-8cc2-cc88364cc6ed","richText":true,"expand":true,"isActive":false},"children":[]},{"data":{"text":"<p>目的</p>","uid":"4b770ed7-d28c-4112-bdb6-ee7f26822b7c","richText":true,"expand":true,"isActive":false},"children":[{"data":{"text":"<p>provider调用端进程对于 provider提供方的超时监测，避免提供方出现长时间阻塞，未能给provider调用方提供服务。--provider提供方不能耗时提供服务</p>","uid":"fbe9d61b-9044-4c06-a72b-a7b0e581f401","richText":true,"expand":true,"isActive":false},"children":[]}]}]},{"data":{"text":"<p><span>Input</span></p>","uid":"3437a5a9-7afa-4232-9bdb-9b8ef62b066f","richText":true,"expand":true,"isActive":false,"fontFamily":"微软雅黑, Microsoft YaHei","fontSize":14,"fontWeight":"normal","fontStyle":"normal","textDecoration":"none","color":"rgb(34, 34, 34)","textAlign":"left","tagPlacement":"right","imgPlacement":"top","paddingX":15,"paddingY":5,"shape":"rectangle","borderWidth":1,"borderRadius":5,"gradientStyle":false,"startColor":"#549688","endColor":"#fff","startDir":[0,0],"endDir":[1,0],"fillColor":"transparent","borderColor":"#4D4D4D","borderDasharray":"none","hoverRectColor":"","hoverRectRadius":5,"lineColor":"rgb(34, 34, 34)","lineDasharray":"none","lineWidth":4,"lineMarkerDir":"start","lineFlow":false,"lineFlowForward":true,"lineFlowDuration":1},"children":[{"data":{"text":"<p>输入事件处理超时</p>","uid":"48b90f2d-10a9-4a53-86b1-a2c1533c6a6a","richText":true,"expand":true,"isActive":false},"children":[{"data":{"text":"<p>5s-Input dispatching timed out (133e8f4 StatusBar is not responding)</p>","uid":"42be300e-a254-4c44-8cb5-d458b5a0c33f","richText":true,"expand":true,"isActive":false},"children":[]},{"data":{"text":"<p>目的</p>","uid":"55371d89-5f45-4fcd-83b4-635e9fdee2e3","richText":true,"expand":true,"isActive":false},"children":[{"data":{"text":"<p>监测应用主线程不能耗时，导致输入事件未能及时处理</p>","uid":"36c8a9bd-9f95-4b17-821a-7f54e0c60b41","richText":true,"expand":true,"isActive":false},"children":[]}]}]},{"data":{"text":"<p>无焦点窗口</p>","uid":"b816974c-22d6-4eff-bc49-24cf007d5d89","richText":true,"expand":true,"isActive":false},"children":[{"data":{"text":"<p>5s-Input dispatching timed out (Application does not have a focused window)</p>","uid":"87427747-37b1-44d4-bc78-de03b99ce761","richText":true,"expand":true,"isActive":false},"children":[]},{"data":{"text":"<p>目的</p>","uid":"cd1c0c6a-87a7-41e7-a76e-0b8b825e1533","richText":true,"expand":true,"isActive":false},"children":[{"data":{"text":"<p>当处于前台的应用，必须要有焦点窗口，事件必须派发到焦点窗口上</p>","uid":"323e75b0-ecfe-4e21-a0f6-449ddb8d2d4f","richText":true,"expand":true,"isActive":false},"children":[]}]}]}]},{"data":{"text":"<p><span>Broadcast</span></p>","uid":"cd41fd67-1c48-46b7-8fba-b3b90cc7c5b8","richText":true,"expand":true,"isActive":false,"fontFamily":"微软雅黑, Microsoft YaHei","fontSize":14,"fontWeight":"normal","fontStyle":"normal","textDecoration":"none","color":"rgb(34, 34, 34)","textAlign":"left","tagPlacement":"right","imgPlacement":"top","paddingX":15,"paddingY":5,"shape":"rectangle","borderWidth":1,"borderRadius":5,"gradientStyle":false,"startColor":"#549688","endColor":"#fff","startDir":[0,0],"endDir":[1,0],"fillColor":"transparent","borderColor":"#4D4D4D","borderDasharray":"none","hoverRectColor":"","hoverRectRadius":5,"lineColor":"rgb(34, 34, 34)","lineDasharray":"none","lineWidth":4,"lineMarkerDir":"end","lineFlow":false,"lineFlowForward":true,"lineFlowDuration":1},"children":[{"data":{"text":"<p>前台广播</p>","uid":"4db241db-76cf-4cc1-8f58-4e84faea573e","richText":true,"expand":true,"isActive":false},"children":[{"data":{"text":"<p>前台10s-Broadcast of Intent { act=com.example.hsytest.SLOW_BROADCAST flg=0x10000010 xflg=0x4 cmp=com.example.hsytest/.SlowBroadcastReceiver (has extras) }</p>","uid":"40c89679-3f29-4fe1-830a-2dc1401745a0","richText":true,"expand":true,"isActive":false},"children":[]},{"data":{"text":"<p>目的</p>","uid":"3c8d916c-da21-455a-94a2-52b5e470f304","richText":true,"expand":true,"isActive":false},"children":[{"data":{"text":"<p>应用进程前台广播接收处理函数不能耗时超过10s</p>","uid":"dedb480f-f17d-4fc7-8879-1954670988ce","richText":true,"expand":true,"isActive":false},"children":[]}]}]},{"data":{"text":"<p>后台广播</p>","uid":"5f035a30-14ce-480d-89cd-1b2b91eb4ce1","richText":true,"expand":true,"isActive":false},"children":[{"data":{"text":"<p>后台60s-Broadcast of Intent { act=com.example.hsytest.SLOW_BROADCAST flg=0x10 xflg=0x4 cmp=com.example.hsytest/.SlowBroadcastReceiver (has extras) }</p>","uid":"61bbb071-8a62-4ced-b44a-45a7ae449432","richText":true,"expand":true,"isActive":false},"children":[]},{"data":{"text":"<p>目的</p>","uid":"73dc7f4b-bb90-4fe4-ae6e-e7d731844ef1","richText":true,"expand":true,"isActive":false},"children":[{"data":{"text":"<p>应用进程后台广播接收处理函数不能耗时超过60s</p>","uid":"32766e65-5c4e-4817-9110-600b6279c711","richText":true,"expand":true,"isActive":false},"children":[]}]}]}]},{"data":{"text":"<p><span>JobService</span></p>","uid":"4ff32076-415c-4b52-8e94-56692d24bfef","richText":true,"expand":true,"isActive":false,"fontFamily":"微软雅黑, Microsoft YaHei","fontSize":14,"fontWeight":"normal","fontStyle":"normal","textDecoration":"none","color":"rgb(34, 34, 34)","textAlign":"left","tagPlacement":"right","imgPlacement":"top","paddingX":15,"paddingY":5,"shape":"rectangle","borderWidth":1,"borderRadius":5,"gradientStyle":false,"startColor":"#549688","endColor":"#fff","startDir":[0,0],"endDir":[1,0],"fillColor":"transparent","borderColor":"#4D4D4D","borderDasharray":"none","hoverRectColor":"","hoverRectRadius":5,"lineColor":"rgb(34, 34, 34)","lineDasharray":"none","lineWidth":4,"lineMarkerDir":"end","lineFlow":false,"lineFlowForward":true,"lineFlowDuration":1},"children":[{"data":{"text":"<p>Job生命周期函数耗时</p>","uid":"65dae9d5-5a22-45b7-a064-1fb46dbe70a2","richText":true,"expand":true,"isActive":false},"children":[{"data":{"text":"<p>8s-No response to onStopJob</p>","uid":"12fa944c-cd7b-4aef-ab75-63c13a9c4185","richText":true,"expand":true,"isActive":false},"children":[]},{"data":{"text":"<p>8s-No response to onStartJob</p>","uid":"38dd0691-1e3a-4a58-be07-0f933df344cd","richText":true,"expand":true,"isActive":false},"children":[]}]},{"data":{"text":"<p>可见Job没有通知</p>","uid":"f4ec6d1f-c2f2-4378-9d68-15b9228b528e","richText":true,"expand":true,"isActive":false},"children":[{"data":{"text":"<p>目的</p>","uid":"62057dde-d386-49f8-b073-1ca93cdea348","richText":true,"expand":true,"isActive":false},"children":[{"data":{"text":"<p>用户可见的Job必须再onStartJob后10s内启动一个通知</p>","uid":"9d65ecd4-5662-4e15-9fbf-69803256a9b4","richText":true,"expand":true,"isActive":false},"children":[]}]},{"data":{"text":"<p>10s-required notification not provided com.example.hsytest/.MissingNotificationJobService]</p>","uid":"be609709-5528-49c8-b518-4822fb2d5921","richText":true,"expand":true,"isActive":false},"children":[]}]}]},{"data":{"text":"<p><span>Service</span></p>","uid":"901b6fb7-9772-4f9d-a2db-eb22c520ea2a","richText":true,"expand":true,"isActive":false,"fontFamily":"微软雅黑, Microsoft YaHei","fontSize":14,"fontWeight":"normal","fontStyle":"normal","textDecoration":"none","color":"rgb(34, 34, 34)","textAlign":"left","tagPlacement":"right","imgPlacement":"top","paddingX":15,"paddingY":5,"shape":"rectangle","borderWidth":1,"borderRadius":5,"gradientStyle":false,"startColor":"#549688","endColor":"#fff","startDir":[0,0],"endDir":[1,0],"fillColor":"transparent","borderColor":"#4D4D4D","borderDasharray":"none","hoverRectColor":"","hoverRectRadius":5,"lineColor":"rgb(34, 34, 34)","lineDasharray":"none","lineWidth":4,"lineMarkerDir":"end","lineFlow":false,"lineFlowForward":true,"lineFlowDuration":1},"children":[{"data":{"text":"<p>service 生命周期函数出现耗时阻塞</p>","uid":"cfcbda16-59d5-4ba0-91c7-540c4b0da583","richText":true,"expand":true,"isActive":false},"children":[{"data":{"text":"<p>前台30s-executing service com.example.hsytest/.ExecutingService, waited 30003ms</p>","uid":"b9a3efa7-4fd3-44b1-a9cc-204b84266710","richText":true,"expand":true,"isActive":false},"children":[]},{"data":{"text":"<p>后台200s-executing service com.example.hsytest/.ExecutingService, waited 200002ms</p>","uid":"51281838-f6d4-4da4-84ba-1ca936c5366b","richText":true,"expand":true,"isActive":false},"children":[]}]},{"data":{"text":"<p>前台服务没有通知</p>","uid":"0e2818cb-23f4-4fd7-b5bd-76fdd6bf131f","richText":true,"expand":true,"isActive":false},"children":[{"data":{"text":"<p>40s-Context.startForegroundService() did not then call Service.startForeground(): ServiceRecord{8a6f7fd u0 com.example.hsytest/.FgsStartTimeoutService c:com.example.hsytest}…</p>","uid":"623b828d-a13b-48f1-bc3e-ff9e9830de76","richText":true,"expand":true,"isActive":false},"children":[]},{"data":{"text":"<p>目的</p>","uid":"f76f6591-ae40-46a0-a342-2ab955b103f0","richText":true,"expand":true,"isActive":false},"children":[{"data":{"text":"<p>应用在后台启动service，必须规定时间30s内展现一个前台通知，超时30s未调用启动通知将会crash，如果10s后该进程未能crash退出则触发anr</p>","uid":"b11f562d-c805-433e-aed3-e7f63a25701f","richText":true,"expand":true,"isActive":false},"children":[]}]}]},{"data":{"text":"<p>Short类型前台服务未结束</p>","uid":"3ef5cd90-38ad-4735-b292-75879ccc96ff","richText":true,"expand":true,"isActive":false},"children":[{"data":{"text":"<p>3分钟-A foreground service of FOREGROUND_SERVICE_TYPE_SHORT_SERVICE did not stop within a timeout</p>","uid":"837ca4ab-baec-4f2f-b07b-4be21515cf94","richText":true,"expand":true,"isActive":false},"children":[]},{"data":{"text":"<p>目的</p>","uid":"17ac9418-1832-47d0-8cf2-319e86ba7dc4","richText":true,"expand":true,"isActive":false},"children":[{"data":{"text":"<p>前台服务中的short类型服务，必须在3分钟之内结束</p>","uid":"46745bd4-6661-4339-b072-383b69025f21","richText":true,"expand":true,"isActive":false},"children":[]}]}]}]}]},{"data":{"text":"<p><span>SWT</span></p>","uid":"1968c9ed-c916-4cbc-98c4-77a6bc62fe2f","richText":true,"expand":true,"isActive":false,"fontFamily":"微软雅黑, Microsoft YaHei","fontSize":18,"fontWeight":"bold","fontStyle":"normal","textDecoration":"none","color":"#fff","textAlign":"left","tagPlacement":"right","imgPlacement":"top","paddingX":15,"paddingY":5,"shape":"rectangle","borderWi
top","paddingX":15,"paddingY":5,"shape":"rectangle","borderWidth":1,"borderRadius":5,"gradientStyle":false,"startColor":"#549688","endColor":"#fff","startDir":[0,0],"endDir":[1,0],"fillColor":"transparent","borderColor":"#4D4D4D","borderDasharray":"none","hoverRectColor":"","hoverRectRadius":5,"lineColor":"rgb(34, 34, 34)","lineDasharray":"none","lineWidth":4,"lineMarkerDir":"end","lineFlow":false,"lineFlowForward":true,"lineFlowDuration":1},"children":[{"data":{"text":"<p>目的</p>","uid":"8c4adbb8-80c4-4af1-acc1-214d4eb02a6c","richText":true,"expand":true,"isActive":false},"children":[{"data":{"text":"<p>重要服务的对象锁不能被某一逻辑模块长时间占用</p>","uid":"bcce9b49-a35f-4329-a776-c364d9eb6fd2","richText":true,"expand":true,"isActive":false},"children":[]}]},{"data":{"text":"<p>Blocked in monitor 关键服务对象 on monitor thread (watchdog.monitor)</p>","uid":"4756658d-3411-4fb2-a197-d30d3f75575e","richText":true,"expand":true,"isActive":false},"children":[]}]},{"data":{"text":"<p><span>Binder线程池监控</span></p>","uid":"aa7982c9-b71d-4b9f-a9d2-548f4b049f57","richText":true,"expand":true,"isActive":false,"fontFamily":"微软雅黑, Microsoft YaHei","fontSize":14,"fontWeight":"normal","fontStyle":"normal","textDecoration":"none","color":"rgb(34, 34, 34)","textAlign":"left","tagPlacement":"right","imgPlacement":"top","paddingX":15,"paddingY":5,"shape":"rectangle","borderWidth":1,"borderRadius":5,"gradientStyle":false,"startColor":"#549688","endColor":"#fff","startDir":[0,0],"endDir":[1,0],"fillColor":"transparent","borderColor":"#4D4D4D","borderDasharray":"none","hoverRectColor":"","hoverRectRadius":5,"lineColor":"rgb(34, 34, 34)","lineDasharray":"none","lineWidth":4,"lineMarkerDir":"end","lineFlow":false,"lineFlowForward":true,"lineFlowDuration":1},"children":[{"data":{"text":"<p>目的</p>","uid":"c3a2fe13-d5e1-4be3-82c3-19b578e4ffe5","richText":true,"expand":true,"isActive":false},"children":[{"data":{"text":"<p>system_server的所有binder线程不能长时间同时出现繁忙被使用的情况</p>","uid":"812287d5-161a-46d3-bd67-f9276a649d84","richText":true,"expand":true,"isActive":false},"children":[]}]},{"data":{"text":"<p>Blocked in monitor com.android.server.Watchdog$BinderThreadMonitor on binder monitor thread (binder monitor) for 70s</p>","uid":"f869fec5-e022-4748-bbf0-7064f7d86d3f","richText":true,"expand":true,"isActive":false},"children":[]}]},{"data":{"text":"<p><span>原因汇总</span></p>","uid":"d490e7bf-e073-495b-acbc-e0751a9bb675","richText":true,"expand":true,"isActive":false,"fontFamily":"微软雅黑, Microsoft YaHei","fontSize":14,"fontWeight":"normal","fontStyle":"normal","textDecoration":"none","color":"rgb(34, 34, 34)","textAlign":"left","tagPlacement":"right","imgPlacement":"top","paddingX":15,"paddingY":5,"shape":"rectangle","borderWidth":1,"borderRadius":5,"gradientStyle":false,"startColor":"#549688","endColor":"#fff","startDir":[0,0],"endDir":[1,0],"fillColor":"transparent","borderColor":"#4D4D4D","borderDasharray":"none","hoverRectColor":"","hoverRectRadius":5,"lineColor":"rgb(34, 34, 34)","lineDasharray":"none","lineWidth":4,"lineMarkerDir":"end","lineFlow":false,"lineFlowForward":true,"lineFlowDuration":1},"children":[{"data":{"text":"<p>1.system_server功能模块导致线程死锁</p>","uid":"e6f5eba2-c6ff-4ad2-9361-fce72fe3edba","richText":true,"expand":true,"isActive":false},"children":[]},{"data":{"text":"<p>2.system_server和其他进程交互过程中存在死锁</p>","uid":"6e5a3f45-488e-4b8f-982d-964d685b4c29","richText":true,"expand":true,"isActive":false},"children":[]},{"data":{"text":"<p>3.系统性能差导致</p>","uid":"1c08ccf8-3400-45d4-8caf-7a125dc44ef0","richText":true,"expand":true,"isActive":false},"children":[{"data":{"text":"<p>IO读写满</p>","uid":"a9f255e5-4dec-43fc-bf76-f278920e58fd","richText":true,"expand":true,"isActive":false},"children":[]},{"data":{"text":"<p>内存不足</p>","uid":"de06f082-58a0-418b-8e78-9a20b1f16745","richText":true,"expand":true,"isActive":false},"children":[]}]},{"data":{"text":"<p>4.其他模块异常导致</p>","uid":"cb405367-702c-4522-91ff-2f24d8cfa39c","richText":true,"expand":true,"isActive":false},"children":[{"data":{"text":"<p>SF</p>","uid":"091666a0-5e83-4144-814a-7f3ebfb213f5","richText":true,"expand":true,"isActive":false},"children":[]},{"data":{"text":"<p>vold</p>","uid":"ff012b08-52c5-4144-9c5e-f3c9f5ab5174","richText":true,"expand":true,"isActive":false},"children":[]},{"data":{"text":"<p>netd</p>","uid":"25aaa7a4-ef27-46ba-b701-cdb562919b41","richText":true,"expand":true,"isActive":false},"children":[]},{"data":{"text":"<p>hwc</p>","uid":"3b929c55-6cc7-4237-b9ea-7442203556db","richText":true,"expand":true,"isActive":false},"children":[]},{"data":{"text":"<p>等</p>","uid":"9336cbe8-1c58-4e07-b3cb-d103ca98d4a7","richText":true,"expand":true,"isActive":false},"children":[]}]},{"data":{"text":"<p>5.驱动模块异常导致</p>","uid":"818cb2cf-2825-457a-86d5-0126eb5a0eac","richText":true,"expand":true,"isActive":false},"children":[{"data":{"text":"<p>死锁</p>","uid":"847f70e4-08a5-4d99-81da-18bef205a98e","richText":true,"expand":true,"isActive":false},"children":[]},{"data":{"text":"<p>长时间D状态</p>","uid":"90c3cf52-cba2-4cdd-9c5e-58b47475b9d1","richText":true,"expand":true,"isActive":false},"children":[]}]}]}]},{"data":{"text":"<p><span>Recovery</span></p>","uid":"925f3e7c-57a8-44ac-8662-3ad273b79449","richText":true,"expand":true,"isActive":false,"fontFamily":"微软雅黑, Microsoft YaHei","fontSize":18,"fontWeight":"bold","fontStyle":"normal","textDecoration":"none","color":"#fff","textAlign":"left","tagPlacement":"right","imgPlacement":"top","paddingX":15,"paddingY":5,"shape":"rectangle","borderWidth":2,"borderRadius":10,"gradientStyle":false,"startColor":"#549688","endColor":"#fff","startDir":[0,0],"endDir":[1,0],"fillColor":"#73D8FF","borderColor":"#333333","borderDasharray":"none","hoverRectColor":"","hoverRectRadius":5,"lineColor":"#4D4D4D","lineDasharray":"none","lineWidth":7,"lineMarkerDir":"end","lineFlow":false,"lineFlowForward":true,"lineFlowDuration":1},"children":[{"data":{"text":"<p><span>RescueParty</span></p>","uid":"9bb6f996-19c9-4f9a-aea6-212cf9c174d3","richText":true,"expand":true,"isActive":false,"fontFamily":"微软雅黑, Microsoft YaHei","fontSize":14,"fontWeight":"normal","fontStyle":"normal","textDecoration":"none","color":"rgb(34, 34, 34)","textAlign":"left","tagPlacement":"right","imgPlacement":"top","paddingX":15,"paddingY":5,"shape":"rectangle","borderWidth":1,"borderRadius":5,"gradientStyle":false,"startColor":"#549688","endColor":"#fff","startDir":[0,0],"endDir":[1,0],"fillColor":"transparent","borderColor":"#4D4D4D","borderDasharray":"none","hoverRectColor":"","hoverRectRadius":5,"lineColor":"rgb(34, 34, 34)","lineDasharray":"none","lineWidth":4,"lineMarkerDir":"end","lineFlow":false,"lineFlowForward":true,"lineFlowDuration":1},"children":[{"data":{"text":"<p>system_server 频繁重启</p>","uid":"716e98f5-6feb-4f5e-8461-aac5ff4256bf","richText":true,"expand":true,"isActive":false},"children":[]},{"data":{"text":"<p>系统应用频繁重启</p>","uid":"bbef5011-a917-4fd2-bd0d-14079cc9285e","richText":true,"expand":true,"isActive":false},"children":[]},{"data":{"text":"<p>目的</p>","uid":"cb65b739-7461-483a-9a3d-3bbec072dc71","richText":true,"expand":true,"isActive":false},"children":[{"data":{"text":"<p>避免系统组件频繁重启可能造成部分文件数据损坏</p>","uid":"bf688942-c8dc-44ac-a27c-1f4abc611ff6","richText":true,"expand":true,"isActive":false},"children":[]}]}]},{"data":{"text":"<p><span>init进程启动阶段挂载异常</span></p>","uid":"ca6868a1-148e-45a3-afa6-ee52b08ad1dd","richText":true,"expand":true,"isActive":false,"fontFamily":"微软雅黑, Microsoft YaHei","fontSize":14,"fontWeight":"normal","fontStyle":"normal","textDecoration":"none","color":"rgb(34, 34, 34)","textAlign":"left","tagPlacement":"right","imgPlacement":"top","paddingX":15,"paddingY":5,"shape":"rectangle","borderWidth":1,"borderRadius":5,"gradientStyle":false,"startColor":"#549688","endColor":"#fff","startDir":[0,0],"endDir":[1,0],"fillColor":"transparent","borderColor":"#4D4D4D","borderDasharray":"none","hoverRectColor":"","hoverRectRadius":5,"lineColor":"rgb(34, 34, 34)","lineDasharray":"none","lineWidth":4,"lineMarkerDir":"end","lineFlow":false,"lineFlowForward":true,"lineFlowDuration":1},"children":[]}]},{"data":{"text":"<p><span>Hung</span></p>","uid":"5fb61900-16d0-47a4-bc6c-97493dddc1b9","richText":true,"expand":true,"isActive":false,"fontFamily":"微软雅黑, Microsoft YaHei","fontSize":18,"fontWeight":"bold","fontStyle":"normal","textDecoration":"none","color":"#fff","textAlign":"left","tagPlacement":"right","imgPlacement":"top","paddingX":15,"paddingY":5,"shape":"rectangle","borderWidth":2,"borderRadius":10,"gradientStyle":false,"startColor":"#549688","endColor":"#fff","startDir":[0,0],"endDir":[1,0],"fillColor":"#73D8FF","borderColor":"#333333","borderDasharray":"none","hoverRectColor":"","hoverRectRadius":5,"lineColor":"#4D4D4D","lineDasharray":"none","lineWidth":7,"lineMarkerDir":"end","lineFlow":false,"lineFlowForward":true,"lineFlowDuration":1},"children":[{"data":{"text":"<p><span>Hung_task</span></p>","uid":"35c3601b-aba4-4533-99db-ae4bca26227e","richText":true,"expand":true,"isActive":false,"fontFamily":"微软雅黑, Microsoft YaHei","fontSize":14,"fontWeight":"normal","fontStyle":"normal","textDecoration":"none","color":"rgb(34, 34, 34)","textAlign":"left","tagPlacement":"right","imgPlacement":"top","paddingX":15,"paddingY":5,"shape":"rectangle","borderWidth":1,"borderRadius":5,"gradientStyle":false,"startColor":"#549688","endColor":"#fff","startDir":[0,0],"endDir":[1,0],"fillColor":"transparent","borderColor":"#4D4D4D","borderDasharray":"none","hoverRectColor":"","hoverRectRadius":5,"lineColor":"rgb(34, 34, 34)","lineDasharray":"none","lineWidth":4,"lineMarkerDir":"end","lineFlow":false,"lineFlowForward":true,"lineFlowDuration":1},"children":[{"data":{"text":"<p>目的</p>","uid":"a8408551-1ad3-4314-9b0e-d3e20262988d","richText":true,"expand":true,"isActive":false},"children":[{"data":{"text":"<p>为了检测那些处于 D 状态且长时间无法被调度运行的进程，如果存在这类进程则 kernel认为这些进程是异常的，会在kernel 日志中打印这些长时间D状态的进程堆栈信息，如果有必要则还可能触发panic</p>","uid":"59a5b9d4-cb54-4e28-b84e-34b48bc722b4","richText":true,"expand":true,"isActive":false},"children":[]}]},{"data":{"text":"<p>检测核心原理</p>","uid":"2c593bd8-0c54-450a-83a2-76827606a4a5","richText":true,"expand":true,"isActive":false},"children":[{"data":{"text":"<p>nvcsw</p>","uid":"aa3151fa-7011-46a9-9964-f6e823c9f933","richText":true,"expand":true,"isActive":false},"children":[{"data":{"text":"<p>nvcsw：n（Number of）v（Voluntary）c（Context）sw（Switch），Number of Voluntary Context Switch，自愿上下文切换次数</p>","uid":"d23f82b1-d6ab-4993-94f2-e5d6462e37ba","richText":true,"expand":true,"isActive":false},"children":[]},{"data":{"text":"<p>主要统计的是因为自身原因主动放弃CPU的次数，场景：等待资源、主动调用sleep、等锁等</p>","uid":"b1f77883-b0a3-4d02-af07-5af94540e8cf","richText":true,"expand":true,"isActive":false},"children":[]}]},{"data":{"text":"<p>nivcsw</p>","uid":"e670721b-2a02-47d7-bb94-c75860f9d686","richText":true,"expand":true,"isActive":false},"children":[{"data":{"text":"<p>n（Number of）iv（Involuntary）c（Context）sw（Switch），Number of Involuntary Context Switch，非自愿上下文切换次数</p>","uid":"6c161cd0-7eb9-4e03-8574-4154708af81f","richText":true,"expand":true,"isActive":false},"children":[]},{"data":{"text":"<p>主要统计的是因为外部原因被动放弃CPU的次数，场景：时间片用完、被高优先级进程抢占</p>","uid":"a4e051dd-9aa1-4412-8438-55a6019e1b77","richText":true,"expand":true,"isActive":false},"children":[]}]},{"data":{"text":"<p>这两个值，任意一个值发生改变都代表进程的被调度过，无论是自愿或者非自愿。如果在长时间120s之外，进程的这两个值都没有发生过改变（增加），那么说明进程一直未能被调度。并且它还是 D 状态，我们认为这个进程可能存在异常</p>","uid":"fa289e46-a52b-4550-8e82-ce210056d8ec","richText":true,"expand":true,"isActive":false},"children":[]}]}]},{"data":{"text":"<p><span>高通-Hung_task</span></p>","uid":"b615a753-6374-4d4b-80d7-1bc7ce1f03bf","richText":true,"expand":true,"isActive":false,"fontFamily":"微软雅黑, Microsoft YaHei","fontSize":14,"fontWeight":"normal","fontStyle":"normal","textDecoration":"none","color":"rgb(34, 34, 34)","textAlign":"left","tagPlacement":"right","imgPlacement":"top","paddingX":15,"paddingY":5,"shape":"rectangle","borderWidth":1,"borderRadius":5,"gradientStyle":false,"startColor":"#549688","endColor":"#fff","startDir":[0,0],"endDir":[1,0],"fillColor":"transparent","borderColor":"#4D4D4D","borderDasharray":"none","hoverRectColor":"","hoverRectRadius":5,"lineColor":"rgb(34, 34, 34)","lineDasharray":"none","lineWidth":4,"lineMarkerDir":"end","lineFlow":false,"lineFlowForward":true,"lineFlowDuration":1},"children":[{"data":{"text":"<p>目的</p>","uid":"6542dd68-6e92-4b62-b24c-8853efffa33a","richText":true,"expand":true,"isActive":false},"children":[{"data":{"text":"<p>基于原生的Hung_task机制做拓展</p>","uid":"2ec05107-61b1-41c1-a1df-553b8ff0f5e7","richText":true,"expand":true,"isActive":false},"children":[{"data":{"text":"<p>1.监测我想要监测task.例如SF等</p>","uid":"5983a2b6-b81b-4e0c-a1bd-f0db714b0939","richText":true,"expand":true,"isActive":false},"children":[]},{"data":{"text":"<p>2.加入iowait Task监控</p>","uid":"c22b28fb-03d0-40d9-a598-26705b3f477f","richText":true,"expand":true,"isActive":false},"children":[]}]}]}]},{"data":{"text":"<p><span>MTK-Hang_detect</span></p>","uid":"356709aa-98e1-4842-8818-b5a5f99a3b5a","richText":true,"expand":true,"isActive":false,"fontFamily":"微软雅黑, Microsoft YaHei","fontSize":14,"fontWeight":"normal","fontStyle":"normal","textDecoration":"none","color":"rgb(34, 34, 34)","textAlign":"left","tagPlacement":"right","imgPlacement":"top","paddingX":15,"paddingY":5,"shape":"rectangle","borderWidth":1,"borderRadius":5,"gradientStyle":false,"startColor":"#549688","endColor":"#fff","startDir":[0,0],"endDir":[1,0],"fillColor":"transparent","borderColor":"#4D4D4D","borderDasharray":"none","hoverRectColor":"","hoverRectRadius":5,"lineColor":"rgb(34, 34, 34)","lineDasharray":"none","lineWidth":4,"lineMarkerDir":"end","lineFlow":false,"lineFlowForward":true,"lineFlowDuration":1},"children":[{"data":{"text":"<p>目的</p>","uid":"eb85f13f-379d-4e1a-93e5-2b1c45590dbd","richText":true,"expand":true,"isActive":false},"children":[{"data":{"text":"<p>弥补原生system_server Watchdog机制的不足，主要让手机能否正常出现重启，并且输出保留日志</p>","uid":"fe15570c-3c83-43d0-90a5-b37af31a5947","richText":true,"expand":true,"isActive":false},"children":[]}]},{"data":{"text":"<p>场景</p>","uid":"30ddfbdc-51b4-4458-87df-9c58a8b49849","richText":true,"expand":true,"isActive":false},"children":[{"data":{"text":"<p>1.system_server SWT 后未能及时上重启，则可能触发</p>","uid":"bdabfdde-eec0-41cf-a6f6-282ba2f0d6cf","richText":true,"expand":true,"isActive":false},"children":[]},{"data":{"text":"<p>2.SF/System_server NE后未能及时上层重启，则可能触发</p>","uid":"88df5930-3ba9-4410-bcd0-be3936161642","richText":true,"expand":true,"isActive":false},"children":[]},{"data":{"text":"<p>3.正常关机流程未能及时关机，则可能触发</p>","uid":"a6eb89cd-f01f-42fd-9962-b193fa20fc20","richText":true,"expand":true,"isActive":false},"children":[]},{"data":{"text":"<p>4.开机过程中，开机时间太长未能开机，可能触发</p>","uid":"57047401-c2b9-4afb-b6f8-a57d4624d597","richText":true,"expand":true,"isActive":false},"children":[]}]}]},{"data":{"text":"<p><span>展锐-Native_hung</span></p>","uid":"eedb72cd-646a-4ed5-a5fe-c9ada10cd63b","richText":true,"expand":true,"isActive":false,"fontFamily":"微软雅黑, Microsoft YaHei","fontSize":14,"fontWeight":"normal","fontStyle":"normal","textDecoration":"none","color":"rgb(34, 34, 34)","textAlign":"left","tagPlacement":"right","imgPlacement":"top","paddingX":15,"paddingY":5,"shape":"rectangle","borderWidth":1,"borderRadius":5,"gradientStyle":false,"startColor":"#549688","endColor":"#fff","startDir":[0,0],"endDir":[1,0],"fillColor":"transparent","borderColor":"#4D4D4D","borderDasharray":"none","hoverRectColor":"","hoverRectRadius":5,"lineColor":"rgb(34, 34, 34)","lineDasharray":"none","lineWidth":4,"lineMarkerDir":"end","lineFlow":false,"lineFlowForward":true,"lineFlowDuration":1},"children":[{"data":{"text":"<p>目的</p>","uid":"88e77e16-22ec-43a4-b9e9-a3a5838c6cd8","richText":true,"expand":true,"isActive":false},"children":[{"data":{"text":"<p>分弥补原生system_server Watchdog机制的不足，主要让手机能否正常出现重启，并且输出保留日志支主题</p>","uid":"ab4f06f1-59d9-4ef8-afde-2c4d9858384d","richText":true,"expand":true,"isActive":false},"children":[]}]},{"data":{"text":"<p>场景</p>","uid":"f026c165-9462-47d3-9e5f-4bf9cf97989e","